{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "ES2022.Intl"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src"]
}
